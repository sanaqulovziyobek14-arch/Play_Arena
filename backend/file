@extend_schema(tags=['Booking'])
class BookingViewSet(CreateModelMixin,
                     RetrieveModelMixin,
                     UpdateModelMixin,
                     ListModelMixin,
                     GenericViewSet):
    """Joy band qilish tizimi."""
    serializer_class = BookingModelSerializer
    permission_classes = [IsAuthenticated]
    filter_backends = [DjangoFilterBackend]
    filterset_class = BookingFilter

    def get_queryset(self):
        user = self.request.user
        if user.is_admin:
            return Booking.objects.select_related("user", "venue").all()
        if user.is_owner:
            return Booking.objects.filter(venue__owner=user).select_related("user", "venue")
        return Booking.objects.filter(user=user).select_related("user", "venue")

    def perform_create(self, serializer):
        if self.request.user.is_owner:
            raise PermissionDenied("Maydon egalari o'z maydonlarini bron qila olmaydi.")
        serializer.save(user=self.request.user)

    def partial_update(self, request, *args, **kwargs):
        booking = self.get_object()
        if booking.user != request.user and request.user.is_admin:
            raise PermissionDenied("Bu bronni bekor qilish huquqingiz yo'q.")
        new_status = request.data.get("status")
        if new_status and new_status != "canceled":
            raise PermissionDenied("Faqat bekor qilish mumkin.")
        return super().partial_update(request, *args, **kwargs)


@extend_schema(
    tags=['Booking'],
    summary="Maydonning band soatlarini olish",
    description="Biror maydon ma'lum bir sanada (date) qaysi soatlarda band bo'lganini ko'rsatadi.",
    parameters=[
        OpenApiParameter(
            name='date',
            type=OpenApiTypes.DATE,
            location=OpenApiParameter.QUERY,
            required=True,
            description="Band soatlarni tekshirish uchun sana (Format: YYYY-MM-DD)"
        )
    ]
)
class VenueBookedSlotsAPIView(APIView):
    """
    Foydalanuvchiga bo'sh soatlarni ko'rib tanlashi uchun
    ma'lum bir sanadagi band vaqtlarni qaytaruvchi API.
    """
    permission_classes = [AllowAny]

    def get(self, request, venue_id):
        date_str = request.GET.get("date")
        if not date_str:
            return Response({"error": "date parametri kerak"}, status=status.HTTP_404_NOT_FOUND)

        try:
            valid_date = datetime.strptime(date_str, "%Y-%m-%d").date()
        except ValueError:
            raise ValidationError({"date": "Sana formati noto'g'ri. YYYY-MM-DD formatida yuboring."})

        if not Venue.objects.filter(pk=venue_id).exists():
            return Response({"error": "Maydon topilmadi"}, status=status.HTTP_404_NOT_FOUND)

        bookings = Booking.objects.filter(
            venue_id=venue_id,
            date=valid_date
        ).values("start_time", "end_time")

        if not bookings.exists():
            return Response({"message": "Bu sanada bronlar yo'q"})

        return Response({
            "booked": [
                {"start": str(b["start_time"]), "end": str(b["end_time"])}
                for b in bookings
            ]
        })



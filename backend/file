class IsOwnerOrAdmin(BasePermission):
    def has_object_permission(self, request, view, obj):
        """Ma'lumotni faqat uning egasi yoki admin o'zgartira oladi. Boshqalar faqat ko'ra oladi (SAFE_METHODS — GET, HEAD, OPTIONS)."""
        if request.method in permissions.SAFE_METHODS:
            return True
        return obj == request.user or request.user.role == "admin"


class IsVenueOwnerOrAdmin(BasePermission):
    """Maydon (Venue) egasi yoki adminga o'zgartirish huquqini beradi."""

    def has_object_permission(self, request, view, obj):
        if request.method in permissions.SAFE_METHODS:
            return True
        return obj.owner == request.user or request.user.is_admin


class IsBookingOwnerOrVenueOwner(permissions.BasePermission):
    """Bron qilingan joyni (Booking) faqat uni bron qilgan odam, shu maydonning egasi yoki admin ko'ra/boshqara oladi."""

    def has_object_permission(self, request, view, obj):
        user = request.user
        return (
                obj.user == user or
                obj.venue.owner == user or
                user.is_admin
        )


